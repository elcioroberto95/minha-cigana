{
  "name": "cigana-do-destino",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "eval:tarot:compare": "node apps/api/evals/compare-three-cards.mjs",
    "start": "npm run start --workspace=@cigana/mobile",
    "android": "npm run android --workspace=@cigana/mobile",
    "ios": "npm run ios --workspace=@cigana/mobile",
    "web": "npm run web --workspace=@cigana/mobile",
    "build:web": "npm run build:web --workspace=@cigana/mobile",
    "dev:api": "npm run dev --workspace=@cigana/api",
    "build:api": "npm run build --workspace=@cigana/api",
    "start:api": "npm run start --workspace=@cigana/api",
    "test:api": "npm run test --workspace=@cigana/api",
    "eval:ai": "node apps/api/evals/run.ts",
    "migrate:api": "npm run migrate --workspace=@cigana/api",
    "lint": "npm run lint --workspaces --if-present",
    "check:architecture": "npm run check:architecture --workspace=@cigana/api",
    "typecheck": "npm run typecheck --workspaces"
  }
}
