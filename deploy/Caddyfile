{
	admin off
}

https://{$CIGANA_PUBLIC_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	request_body {
		max_size 64KB
	}
	header Cache-Control "no-store"
	@backend path /api/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Cigana-Public 1
			transport http {
				response_header_timeout 100s
			}
		}
	}
	handle {
		respond 404
	}
}
