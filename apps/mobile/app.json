{
  "expo": {
    "name": "Cigana do Destino",
    "slug": "cigana-do-destino",
    "version": "0.1.0",
    "scheme": "ciganadodestino",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "pt-BR",
            "en-US"
          ]
        }
      ],
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": "Permita que o Cigana do Destino grave sua pergunta quando você escolher enviar áudio.", "enableBackgroundPlayback": false }]
    ],
    "web": {
      "output": "single"
    }
  }
}
