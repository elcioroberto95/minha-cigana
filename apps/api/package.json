{
  "name": "@cigana/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.evals.json",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src && node scripts/check-computed-imports.mjs",
    "pretest": "npm run build",
    "migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.9.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
